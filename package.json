{
  "name": "qa-automation-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Intensive Senior Test Automation interview prep: Playwright, TypeScript, Java + Selenium, Python + Pytest, with in-browser runners.",
  "type": "module",
  "scripts": {
    "start": "http-server . -p 4173 -c-1 --silent",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "build": "node scripts/build-single.mjs",
    "export:exercises": "node scripts/export-exercises.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.3",
    "codemirror": "^5.65.16",
    "http-server": "^14.1.1",
    "pyodide": "^0.26.4",
    "skulpt": "^1.2.0",
    "typescript": "^5.6.3"
  },
  "license": "MIT"
}
